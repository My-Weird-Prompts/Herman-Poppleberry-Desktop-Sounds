[Unit]
Description=Herman Poppleberry desktop announcements
After=graphical-session.target pipewire.service pipewire-pulse.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/herman-watch
ExecStop=%h/.local/bin/herman-farewell
TimeoutStopSec=10
Restart=on-failure

[Install]
WantedBy=graphical-session.target
